{
  "name": "worship-plus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema de gestão de cultos, escalas e repertório com design premium glassmorphism",
  "author": "Worship+ Team",
  "license": "MIT",
  "homepage": "https://worshipplus.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/worshipplus/worship-plus.git"
  },
  "scripts": {
    "prepare": "cd .. && node frontend/node_modules/husky/lib/bin.js install",
    "dev": "vite --host",
    "dev:https": "vite --https --host",
    "vite:build": "vite build",
    "build": "npm run -s tsc:build && npm run -s vite:build",
    "preview": "vite preview --host",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:staged": "eslint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "format:staged": "prettier --write",
    "type-check": "tsc --noEmit",
    "tsc:build": "tsc -b --pretty false",
    "ci:prepush": "npm run -s lint:css && npm run -s tsc:build",
    "test": "vitest",
    "test:unit": "vitest run --coverage --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "pre-commit": "npm run lint && npm run type-check && npm run test:unit && npm run build",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "build:analyze": "vite-bundle-visualizer",
    "clean": "rm -rf dist node_modules/.vite"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.4",
    "lucide-react": "^0.294.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@playwright/test": "^1.40.1",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/addon-interactions": "8.6.18",
    "@storybook/addon-links": "8.6.18",
    "@storybook/blocks": "8.6.18",
    "@storybook/react": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@storybook/test": "8.6.18",
    "@storybook/testing-library": "^0.2.2",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/node": "^20.10.4",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.0.4",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "eslint-plugin-storybook": "^0.6.15",
    "husky": "^8.0.3",
    "jsdom": "^23.0.1",
    "lint-staged": "^15.2.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.0",
    "storybook": "8.6.18",
    "stylelint": "^17.11.1",
    "tailwindcss": "^3.3.6",
    "typescript": "5.9.3",
    "vite": "^5.4.11",
    "vite-bundle-visualizer": "^0.11.0",
    "vitest": "^1.0.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=9.0.0"
  }
}
